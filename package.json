{
  "name": "slack-ai-agents",
  "version": "1.0.0",
  "type": "module",
  "repository": "https://github.com/hyewon3938/slack-ai-agents.git",
  "author": "hyewon3938",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "node --import tsx src/app.ts",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "dev:web": "yarn --cwd web dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@slack/bolt": "^4.7.0",
    "@stdlib/stats-base-dists-beta-quantile": "^0.2.3",
    "dotenv": "^17.3.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.3"
  }
}
